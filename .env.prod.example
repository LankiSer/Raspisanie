# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=schedule_saas
POSTGRES_USER=schedule_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_HERE
JWT_EXPIRES=3600

# ── App ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://raspisanie.vksit.ru,https://www.raspisanie.vksit.ru
TZ=Europe/Moscow
DEBUG=false
LOG_LEVEL=WARNING
